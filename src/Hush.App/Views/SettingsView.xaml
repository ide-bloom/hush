<UserControl x:Class="Hush.App.Views.SettingsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="These settings are shared with the hush command line ('hush config')." />

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Session" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />
          <Label Content="_Lock after this many idle minutes" Target="{Binding ElementName=IdleBox}" Padding="0,0,0,4" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Slider x:Name="IdleSlider" Minimum="1" Maximum="120" Width="300" TickFrequency="5" IsSnapToTickEnabled="False" ValueChanged="OnSlider"
                    AutomationProperties.Name="Idle timeout slider" VerticalAlignment="Center" />
            <TextBox x:Name="IdleBox" Width="70" Margin="12,0,0,0" TextChanged="OnIdleText" AutomationProperties.Name="Idle timeout in minutes" />
            <TextBlock Text="min" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
          <CheckBox x:Name="LockOnSleep" Content="Lock when the PC _sleeps or hibernates" Margin="0,0,0,6" />
          <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                     Text="Locking Windows (Win+L), switching users and disconnecting a remote session always lock the vault." />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Scan roots" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
          <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Folders searched for .env files and project MCP configs. MCP client configs, credential files and shell history are always scanned." />
          <ListBox x:Name="Roots" Height="130" Margin="0,0,0,8" AutomationProperties.Name="Scan roots" />
          <StackPanel Orientation="Horizontal">
            <Button Content="A_dd folder..." Click="OnAddRoot" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="_Remove" Click="OnRemoveRoot" Padding="14,6" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Startup" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />
          <CheckBox x:Name="StartWithWindows" Content="Start Hush in the notification area when I sign in to _Windows" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal">
        <Button Content="_Save" Click="OnSave" Padding="20,6" Style="{DynamicResource AccentButtonStyle}" />
        <TextBlock x:Name="Saved" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
