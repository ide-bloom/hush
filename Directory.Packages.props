<Project>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime dependencies (kept deliberately small). -->
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="Tomlyn" Version="2.11.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="11.0.0" />

    <!--
      Analyzers must be compiled against a Roslyn version that is not newer than the compiler that
      loads them, so this stays on the oldest Roslyn that ships with the .NET 10 SDK band.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />

    <!-- Tests. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
  </ItemGroup>
</Project>
