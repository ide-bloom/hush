<Window x:Class="Hush.App.Dialogs.MigrationPreviewWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview migration" Width="900" Height="680" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Preview migration" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
      <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="_Migrate" IsDefault="True" Click="OnMigrate" Padding="20,6" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
      <Button Content="Cancel" IsCancel="True" Padding="20,6" />
    </StackPanel>
    <TabControl>
      <TabItem Header="_Changes">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="ChangesText" TextWrapping="Wrap" Margin="8" />
        </ScrollViewer>
      </TabItem>
      <TabItem Header="_Diff (redacted)">
        <RichTextBox x:Name="DiffBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Diff" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
