<UserControl x:Class="Hush.App.Views.AuditView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Audit log" Style="{StaticResource PageTitle}" />
      <TextBlock Style="{StaticResource PageSubtitle}"
                 Text="Every unlock, lock and secret access, with the requesting process and its parent. Entries are HMAC-chained so edits, deletions and truncation are detectable." />
      <DockPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Content="_Verify chain" Click="OnVerify" Padding="14,6" Margin="0,0,8,0" />
          <Button Content="Re_fresh" Click="OnRefresh" Padding="14,6" Margin="0,0,16,0" />
          <Border x:Name="Indicator" CornerRadius="12" Padding="10,4" Visibility="Collapsed" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="IndicatorGlyph" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,6,0" />
              <TextBlock x:Name="IndicatorText" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <ComboBox x:Name="ActionFilter" Width="170" Margin="0,0,8,0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Filter by action" />
          <TextBox x:Name="TextFilter" Width="220" TextChanged="OnFilterChanged" AutomationProperties.Name="Filter text"
                   ToolTip="Filter by secret, process or detail" />
        </StackPanel>
      </DockPanel>
      <TextBlock x:Name="Problems" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
    </StackPanel>
    <DataGrid x:Name="Entries" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
              AutomationProperties.Name="Audit entries">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="60" />
        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="150" />
        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="130" />
        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" />
        <DataGridTextColumn Header="Secrets" Binding="{Binding Secrets}" Width="*" />
        <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="*" />
        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
