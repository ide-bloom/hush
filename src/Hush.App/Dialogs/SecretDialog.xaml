<Window x:Class="Hush.App.Dialogs.SecretDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secret" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock x:Name="Heading" Text="Add secret" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

    <Label Content="_Name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" />
    <TextBox x:Name="NameBox" Margin="0,0,0,12" AutomationProperties.Name="Name" />

    <Label Content="_Scope (project; leave empty for a global secret)" Target="{Binding ElementName=ScopeBox}" Padding="0,0,0,4" />
    <TextBox x:Name="ScopeBox" Margin="0,0,0,12" AutomationProperties.Name="Scope" />

    <Label Content="_Policy" Target="{Binding ElementName=PolicyBox}" Padding="0,0,0,4" />
    <ComboBox x:Name="PolicyBox" Margin="0,0,0,12" SelectedIndex="0" AutomationProperties.Name="Policy">
      <ComboBoxItem Content="Session: available while the vault is unlocked" />
      <ComboBoxItem Content="Always prompt: Windows Hello on every use" />
    </ComboBox>

    <Label x:Name="ValueLabel" Content="_Value" Target="{Binding ElementName=ValueBox}" Padding="0,0,0,4" />
    <Grid Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <PasswordBox x:Name="ValueBox" Grid.Column="0" AutomationProperties.Name="Value" />
      <TextBox x:Name="RevealedBox" Grid.Column="0" Visibility="Collapsed" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Revealed value" />
      <Button x:Name="RevealButton" Grid.Column="1" Content="_Reveal" Margin="8,0,0,0" Padding="12,4" Click="OnReveal"
              ToolTip="Show the value (asks for Windows Hello)" />
    </Grid>
    <TextBlock x:Name="ValueHint" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
               Text="The value is sent straight to the Hush agent and encrypted. It is never written to disk in plaintext." />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="_Save" IsDefault="True" Click="OnSave" Padding="20,6" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
      <Button Content="Cancel" IsCancel="True" Padding="20,6" />
    </StackPanel>
  </StackPanel>
</Window>
